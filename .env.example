# токен от @BotFather
BOT_TOKEN=
BOT_TITLE=Альтрон

# id чатов, где бот работает (через запятую). Пусто = любой чат; узнать id — /chatid в чате
ALLOWED_CHATS=
# telegram id старосты — админ везде, ему доступно /menu
OWNER_IDS=

# как к боту обращаются (плюс @username и реплай на его сообщение)
BOT_NAMES=альтрон,альторон,ультрон,altron,ultron

# модель (Tooken). Пусто LLM_API_KEY = берётся переменная TOKEN_CLUB_API_KEY
LLM_BASE_URL=https://tooken.club/v1
LLM_MODEL=claude-sonnet-5-5
VISION_MODEL=gpt-6.2-sol
SMART_MODEL=gpt-6.2-sol
LLM_API_KEY=

# сколько сообщений бот видит, кулдаун на человека (сек)
HISTORY=80
COOLDOWN=1.5
# шанс самому влезть в разговор и пауза между такими влезаниями (сек)
ACTIVE_CHANCE=0.07
ACTIVE_COOLDOWN=60
# флуд: сообщений за минуту и как часто реагировать на него (сек)
FLOOD_N=15
FLOOD_COOLDOWN=300

# доп. характер (лучше править через /menu → Характер)
PERSONA=

# где хранить базу и память (пусто = папка бота)
DATA_DIR=
# приватный репозиторий с историей чатов и людей + токен для пуша (на сервере)
MEMORY_REPO=WhIteGh0s1/ultron-memory
GH_TOKEN=
SYNC_MINUTES=10
# 1 = бот сам подтягивает новый код из GitHub и перезапускается
AUTO_UPDATE=0
UPDATE_MINUTES=10
